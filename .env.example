# Copy to .env.local (never commit). Leave blank for local mode: SQLite on disk.
# Hosted mode: set both in Vercel -> Project Settings -> Environment Variables.
SUPABASE_URL=https://smdqgqhurvonvegvcnuh.supabase.co
# Server-side only. NEVER prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional model backend. Off by default; Ollama only works locally.
INTERVIEW_READY_LLM=off

# Optional AI (Groq). Server-side only. NEVER prefix with NEXT_PUBLIC_. Off until you opt in inside the app.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# 0 or unset = no daily cap. Set a number to bound spend, especially on a public deployment.
# AI_DAILY_CAP=50
