# Copy to .env.local (never commit). Leave blank for local mode: SQLite, no login.
# Set these in Vercel -> Project Settings -> Environment Variables for hosted mode.

# Frontend (public by design; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Python API (same project values). Do NOT add the service-role key; the API uses the caller's JWT.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional model backend. Off by default; Ollama only works locally.
INTERVIEW_READY_LLM=off
